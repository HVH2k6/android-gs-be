DATABASE_URL=
# Redis for Celery/ARQ task queue and caching
REDIS_URL=
OPENAI_API_KEY=
# JWT Authentication
JWT_SECRET_KEY=
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# AI/LLM Configuration
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# LLM Model Selection
DEFAULT_LLM_PROVIDER="openai"  # openai, anthropic, gemini
DEFAULT_LLM_MODEL="gpt-4"

# Embedding Model for RAG
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS=1536

# Analysis Pipeline Configuration
ENABLE_GRADLE_BUILD=true
ENABLE_LINT_CHECK=true
ENABLE_LLM_ANALYSIS=true
ENABLE_RAG_SEARCH=true

# Sandbox Execution (Docker)
DOCKER_ENABLED=true
SANDBOX_CPU_LIMIT="1.0"
SANDBOX_MEMORY_LIMIT="512m"
SANDBOX_TIMEOUT_SECONDS=60
GRADLE_DOCKER_IMAGE="gradle:8.5-jdk17"

# File Upload Limits
MAX_FILE_SIZE_BYTES=10485760  # 10MB
MAX_PROJECT_SIZE_BYTES=104857600  # 100MB

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANALYSIS_PER_MINUTE=10
RATE_LIMIT_SYNC_PER_MINUTE=30

# WebSocket Configuration
WS_HEARTBEAT_INTERVAL=30
WS_RECONNECT_DELAY=5
WS_MAX_RECONNECT_ATTEMPTS=5

# Background Task Queue
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_TIMEOUT=300

# Logging
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR
LOG_FILE="logs/backend.log"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# Environment
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
